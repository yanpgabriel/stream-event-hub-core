DEPLOY_REMOTE_USER=deploy
DEPLOY_REMOTE_HOST=example.com
DEPLOY_REMOTE_DIR=/opt/stream-event-hub-core
DEPLOY_CONTAINER_NAME=stream-event-hub-core
DEPLOY_IMAGE_NAME=stream-event-hub-core
DEPLOY_PORT=3232
DEPLOY_DATA_VOLUME=/opt/stream-event-hub-core/data:/app/data

# If your Docker host stores application data on another disk, point both values there instead.
# Example:
# DEPLOY_REMOTE_DIR=/srv/apps/stream-event-hub-core
# DEPLOY_DATA_VOLUME=/srv/apps/stream-event-hub-core/data:/app/data

# Optional SSH-key settings:
# DEPLOY_SSH_KEY_PATH=~/.ssh/id_ed25519
# DEPLOY_SSH_PORT=22
#
# Remote Docker commands default to `sudo -n`.
# Leave this enabled only if the remote user has passwordless sudo.
# DEPLOY_USE_SUDO=true
